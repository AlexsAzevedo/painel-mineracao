{
  "name": "painel-mineracao",
  "productName": "Painel de Mineração",
  "version": "1.7.0",
  "description": "Painel pessoal de mineração com placas de vídeo: placas, setup, diário de ganhos, anúncios e preços no Brasil.",
  "main": "main.js",
  "author": {
    "name": "Alexsander Azevedo",
    "email": "alexs_azevedo@hotmail.com"
  },
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "gerar": "python3 scripts/gerar-index.py",
    "start": "electron .",
    "build:win": "node scripts/build-win.js"
  },
  "devDependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/sora": "5.3.0",
    "electron": "44.6.0",
    "electron-builder": "26.17.0",
    "resedit": "3.1.0"
  },
  "build": {
    "appId": "br.alex.painelmineracao",
    "productName": "Painel de Mineração",
    "executableName": "PainelMineracao",
    "copyright": "© 2026 Alexsander Azevedo · feito com a ajuda do Claude (Anthropic)",
    "files": [
      "main.js",
      "preload.js",
      "sincronia.js",
      "kryptex-app.js",
      "sensores-amd.js",
      "app/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "sensores-amd.ps1",
        "to": "sensores-amd.ps1"
      }
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "electronLanguages": [
      "pt-BR",
      "en-US"
    ],
    "compression": "maximum",
    "afterPack": "scripts/afterPack.js",
    "publish": [
      {
        "provider": "github",
        "owner": "AlexsAzevedo",
        "repo": "painel-mineracao",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Painel de Mineração",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "installerLanguages": [
        "pt_BR"
      ],
      "language": "1046",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "artifactName": "Painel-de-Mineracao-Setup-${version}.exe"
    }
  },
  "dependencies": {
    "electron-updater": "6.8.10",
    "qrcode-generator": "2.0.4"
  }
}
